# Copy to .env and fill in. .env is gitignored; .env.example is not.

# Set to "true" only once the Worker actually has a RESEND_API_KEY
# (npx wrangler secret put RESEND_API_KEY). It reveals the password-reset
# link and lets the app tell people to watch their inbox. Leaving it unset
# with a key configured just means the reset link stays hidden.
VITE_EMAIL_ENABLED=

# Public half of the Turnstile widget. The private half is a Worker secret
# (npx wrangler secret put TURNSTILE_SECRET). Both halves or neither —
# one alone is no protection at all.
VITE_TURNSTILE_SITE_KEY=
