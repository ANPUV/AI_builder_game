{
  "name": "aifor-study",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,ui -c blue,green \"npm:dev:api\" \"npm:dev:ui\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "card": "node tools/build-reference-card.mjs",
    "progression": "node tools/progression-test.mjs",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "deploy": "npm run check:secrets && npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "db:create": "wrangler d1 create aifor-study-beta",
    "db:migrate": "wrangler d1 migrations apply aifor-study-beta --remote",
    "db:migrate:local": "wrangler d1 migrations apply aifor-study-beta --local",
    "check:secrets": "node tools/check-secrets.mjs",
    "dev:ui": "vite",
    "dev:api": "wrangler dev --port 8788",
    "check:i18n": "node tools/check-translations.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "wrangler": "^4.86.0"
  }
}
